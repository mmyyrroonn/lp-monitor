node_modules/
dist/
.env
.env.*
!.env.example
data/
.pnpm-store/
artifacts/**/requests.jsonl
artifacts/**/raw/
coverage/
artifacts/ci/

# Only the audited P0 acceptance capture is committed; new runs remain local.
!artifacts/p0/raw/
artifacts/p0/raw/*
!artifacts/p0/raw/2026-09-08T06-10-51-129Z/
!artifacts/p0/raw/2026-09-08T06-10-51-129Z/**
!artifacts/p0/probe-2026-09-08T06-10-03-471Z/requests.jsonl
# Local research/tooling retained outside application source control.
research/
tooling/
.commandcode/
.agents/
skills-lock.json

# Rotated transient request evidence follows the same policy as the active file.
artifacts/**/requests.jsonl.*

# P1 per-batch runtime payloads stay local; retain small run summaries.
/artifacts/p1/live/runs/*/*
!/artifacts/p1/live/runs/*/manifest.json

# Console streams are transient; retain manifests and test summaries instead.
/artifacts/p1/live/*.stdout.txt
/artifacts/p1/live/*.stderr.txt

# Timestamped per-run payload dumps under artifacts/p1 stay local: they are
# reconstructible from the recorder database, and a single run directory reaches
# gigabytes, so only the compact summaries at the p1 root belong in the index.
/artifacts/p1/2*/

# Local agent task briefs and review scratch.
.superpowers/

# P5 immutable local replay/study payloads; retain latest compact reports and acceptance.
/artifacts/p5/raw/
/artifacts/p5/replay-native-check/
/artifacts/p5/study-*/

# P6 local raw runs and console streams; retain compact verified reports separately.
/artifacts/p6/runs/
/artifacts/p6/*.stdout.log
/artifacts/p6/*.stderr.log
/artifacts/p6/comparison-*/range-*.json

# P6 diagnostic database copies and raw reproduction inputs remain local.
/artifacts/p6/**/*.sqlite
/artifacts/p6/**/*.sqlite-wal
/artifacts/p6/**/*.sqlite-shm
/artifacts/p6/save-raw-reproduction/range.json

# Catalogue discovery run outputs stay local. The per-range evidence payloads are large and
# are reconstructible from the recorder database, so importing them wholesale would only
# put gigabytes into the index. Publish the pool list from the database instead.
/artifacts/catalogue/

# Live performance runs keep their raw payloads, console streams, patches, CPU profiles and
# the provenance manifests of uncommitted work trees local. The compact benchmark.json and
# summary.json of a run directory are the parts worth keeping -- a payload directory alone
# reaches gigabytes, which is what this rule exists to keep out of the index.
/artifacts/performance/**/artifacts/
/artifacts/performance/*.log
/artifacts/performance/*.patch
/artifacts/performance/**/*.cpuprofile
/artifacts/performance/*-source-provenance.json
