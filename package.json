{
  "name": "robinhood-rwa-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "lp": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "lint:semantic": "oxlint --type-aware --deny-warnings src/rpc src/ops/shutdown.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "lint": "node scripts/check-scripts.mjs && prettier --check \"src/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "dashboard": "pnpm build && node dist/cli.js dashboard"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@uniswap/sdk-core": "7.19.2",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-sdk": "2.3.3",
    "ethers": "6.17.0",
    "happy-dom": "20.14.5",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
