{
  "name": "robinhood-rwa-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "lp": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "lint": "node scripts/check-scripts.mjs && pnpm format:check",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@uniswap/sdk-core": "7.19.2",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-sdk": "2.3.3",
    "ethers": "6.17.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
